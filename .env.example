# Copy to .env (never commit .env).

# Images (built by GitHub Actions, pushed to GHCR). Pin to a release tag or git SHA for rollbacks.
RFP_TAG=latest

# Postgres
POSTGRES_USER=rfp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rfp
POSTGRES_HOST_PORT=5432

# Web: the external reverse proxy (which terminates TLS) forwards to this port.
WEB_BIND=0.0.0.0
WEB_PORT=8080
PUBLIC_URL=https://rawfootballpotential.com   # http://localhost:8080 locally

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
# Only for local development with the Vite dev server (it is a different origin than PUBLIC_URL):
# EXTRA_ORIGINS=http://localhost:5173

# Ingest
TZ=America/New_York
INGEST_SCHEDULES_ENABLED=true
LOG_LEVEL=info

# Backups (local always; S3 copy only if S3_BUCKET is set)
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
S3_BUCKET=
S3_PREFIX=rfp/
S3_ENDPOINT_URL=             # e.g. https://s3.us-west-004.backblazeb2.com for B2; empty for AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

