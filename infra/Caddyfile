# Serves the SPA and proxies /api to the backend on the same origin
# (no CORS; admin session cookies just work).
# TLS is terminated by the external reverse proxy; Caddy only speaks plain HTTP here.
{
	auto_https off
	servers {
		# Trust X-Forwarded-For/Proto from the upstream proxy (private networks / Docker).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Health for the uptime monitor and the deploy workflow (the API itself serves it at /healthz).
	handle /api/healthz {
		rewrite * /healthz
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Content-hashed build files. A missing one must be a real 404, never the SPA page: the browser would take index.html for a
	# broken script/stylesheet ("Unable to preload CSS"). Hits are cached forever; misses are never cached (a deploy can race a visitor).
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}

	handle {
		root * /srv
		# index.html must always revalidate so new deploys are picked up.
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
