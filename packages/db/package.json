{
  "name": "@rfp/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsdown",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
